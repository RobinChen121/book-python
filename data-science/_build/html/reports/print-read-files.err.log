import matplotlib.pyplot as plt
from wordcloud import WordCloud

# Read the text file (ensure 'game of thrones.txt' is in the same directory or provide the correct path)
with open('texts/game of thrones.txt', 'r') as f:
    text = f.read()

# Create and configure the word cloud object
wordcloud = WordCloud(
    width=1000,                # Width of the image
    height=600,                # Height of the image
    background_color='white',  # Background color of the word cloud
    max_words=50,              # Maximum number of words to display
    min_word_length=2,         # Ignore words with length less than 2 (removes single-character words)
    colormap='coolwarm',         # Color scheme (e.g., 'coolwarm', 'magma', 'plasma', 'viridis', etc.)
    contour_width=1,           # Width of the outline
    contour_color='steelblue'  # Color of the outline
).generate(text)

# Save the generated word cloud as an image file in the 'pics' folder
wordcloud.to_file('pics/game_of_thrones_wordcloud.png')

